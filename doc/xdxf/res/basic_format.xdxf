<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xdxf SYSTEM "http://xdxf.sourceforge.net/xdxf_lousy.dtd">
<xdxf lang_from="eng" lang_to="eng" format="visual">
	<full_name>basic_format</full_name>
	<description>basic inline formatting tags</description>
	<lexicon>
		<ar>
			<k>format</k>
			<dtrn>normal <b>bold</b> <i>italic</i> <u>under</u> <sub>sub</sub> <sup>sup</sup> <tt>mono</tt> text</dtrn>
		</ar>
	</lexicon>
</xdxf>
