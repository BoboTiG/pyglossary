<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xdxf SYSTEM "http://xdxf.sourceforge.net/xdxf_lousy.dtd">
<xdxf lang_from="eng" lang_to="eng" format="visual">
	<full_name>blockquote</full_name>
	<description>&lt;blockquote&gt; as indented block</description>
	<lexicon>
		<ar>
			<k>quote</k>
			<dtrn>definition</dtrn>
			<blockquote>quoted passage</blockquote>
		</ar>
	</lexicon>
</xdxf>
