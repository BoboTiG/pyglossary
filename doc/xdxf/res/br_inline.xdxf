<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xdxf SYSTEM "http://xdxf.sourceforge.net/xdxf_lousy.dtd">
<xdxf lang_from="eng" lang_to="eng" format="visual">
	<full_name>br_inline</full_name>
	<description>explicit &lt;br/&gt; inside a definition</description>
	<lexicon>
		<ar>
			<k>br</k>
			<dtrn>first<br/>second <br/> third</dtrn>
		</ar>
	</lexicon>
</xdxf>
