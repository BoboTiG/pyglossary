<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xdxf SYSTEM "http://xdxf.sourceforge.net/xdxf_lousy.dtd">
<xdxf lang_from="eng" lang_to="eng" format="visual">
	<full_name>transcription</full_name>
	<description>transcription in brackets, &lt;c&gt;/&lt;co&gt;/&lt;abr&gt; inline formatting</description>
	<lexicon>
		<ar>
			<k>'Arry</k>
			<tr>ˈærɪ</tr>
			 <abr>сущ.</abr>
			 1) <c><dtrn><co><abr><i>прост.</i></abr>; = <kref>Harry</kref></co></dtrn></c>
		</ar>
	</lexicon>
</xdxf>
